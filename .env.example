# Copy to .env and fill in the blanks. .env is gitignored: never commit it.
# Read by docker compose and by the Spring Boot backend.

POSTGRES_DB=mywargame
POSTGRES_USER=mywargame
POSTGRES_PASSWORD=

# HS256 signing key for JWTs, 32+ characters. Generate one with: openssl rand -base64 48
APP_JWT_SECRET=
